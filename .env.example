# ── Credenciales de LaLiga Fantasy ────────────────────────────────────────
# Sólo funcionan si la cuenta se creó con EMAIL + CONTRASEÑA
# (el login social de Google/Facebook no permite este flujo).
FANTASY_EMAIL=tu@email.com
FANTASY_PASSWORD=tu-contraseña

# ── Alternativa: token pegado a mano ──────────────────────────────────────
# Si tu cuenta es de Google, saca el token desde fantasy.laliga.com
# (DevTools → Application → Local Storage) y pégalo aquí. Caduca cada 24 h.
# Si está definida, tiene prioridad sobre email/contraseña.
# FANTASY_TOKEN=

# ── Opcionales ────────────────────────────────────────────────────────────
# Fija una liga concreta si estás en varias (si no, coge la primera).
# FANTASY_LEAGUE_ID=

# Contraseña de acceso al panel. Déjala vacía en local.
# En producción, entra una vez con https://tu-web/?key=ESTA_CLAVE
# APP_PASSWORD=
